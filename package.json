{
  "name": "chacota",
  "private": true,
  "description": "Chacota: juegos comunitarios para meetups y streams (Tiluchi = quizzes estilo Kahoot)",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:services": "podman compose up -d || docker compose up -d",
    "db:init": "CHACOTA_TABLE=chacota-local pnpm --filter @chacota/db create-local-table",
    "local:init": "NODE_EXTRA_CA_CERTS=${NODE_EXTRA_CA_CERTS:-$HOME/.aws/emulator/9297/ca.pem} pnpm --filter @chacota/api local-init",
    "media:init": "pnpm --filter @chacota/db create-local-bucket",
    "dev": "pnpm --filter @chacota/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dev:game": "pnpm --filter @chacota/api dev",
    "e2e": "corepack pnpm --filter @chacota/e2e start"
  }
}
