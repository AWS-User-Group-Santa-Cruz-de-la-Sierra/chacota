# Copia a .env.local. Perfil local sobre el AWS Emulator: `pnpm dev:services` y `pnpm local:init`.
# COGNITO_USER_POOL_ID, COGNITO_CLIENT_ID y EVENTS_API_KEY los genera `pnpm local:init` en
# .env.development.local (no los pongas acá). Para la nube, usá los valores de `cdk deploy`
# (infra/cdk-outputs.*.json) y quitá CHACOTA_LOCAL_AUTH, COGNITO_LOCAL_ENDPOINT y las AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY de mentira.
AMPLIFY_APP_ORIGIN=http://localhost:3000
# Ingreso local contra el Cognito del emulador (usuarios dev@chacota.local y e2e@chacota.local)
CHACOTA_LOCAL_AUTH=emulator
COGNITO_LOCAL_ENDPOINT=https://127.0.0.1:9297
# Credenciales de mentira: el emulador no las valida
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1

# DynamoDB Local (podman compose up -d)
CHACOTA_TABLE=chacota-local
DYNAMODB_ENDPOINT=http://localhost:8000

# Medios (logos e imágenes). Local: AWS Emulator (pnpm dev:services + pnpm local:init); el navegador
# sube y lee a través de pnpm dev:game (/media en :4000), porque no confía en el certificado del emulador.
S3_ENDPOINT=https://127.0.0.1:9297
MEDIA_BUCKET=chacota-media-local
MEDIA_PUBLIC_URL=http://localhost:4000/media
MEDIA_UPLOAD_MODE=local
# Nube: MEDIA_BUCKET=<MediaBucketName>, MEDIA_PUBLIC_URL=<MediaUrl> de cdk-outputs, sin S3_ENDPOINT
# y MEDIA_UPLOAD_MODE=presigned (o vacío).

# Aprueba organizaciones nuevas automáticamente (útil en local o en instalaciones privadas)
CHACOTA_AUTO_APPROVE_ORGS=true

# Juego en vivo.
# Dirección que ven los jugadores en el QR (por defecto AMPLIFY_APP_ORIGIN):
CHACOTA_PUBLIC_ORIGIN=
# EVENTS_API_KEY: lo genera pnpm local:init en .env.development.local (no lo pongas acá).
# Modo local: pnpm dev:game levanta la API en :4000; los eventos van por el AppSync del emulador
# (HTTP en :4101 para publicar, y ws en :4100 para el navegador, vía realtime-tls).
GAME_API_URL=http://localhost:4000
EVENTS_HTTP_DNS=127.0.0.1:4101
EVENTS_REALTIME_URL=ws://127.0.0.1:4100/event/realtime
# Modo nube: usá GameApiUrl, EventsHttpDns, EventsRealtimeDns y EventsApiKey de cdk-outputs,
# EVENTS_REALTIME_URL=wss://<EventsRealtimeDns>/event/realtime, EVENTS_API_KEY=<EventsApiKey>
# y apuntá CHACOTA_TABLE a la tabla de la nube (sin DYNAMODB_ENDPOINT).
