# Copia a .env.local. Los valores de Cognito salen de `cdk deploy` (infra/cdk-outputs.dev.json).
AMPLIFY_APP_ORIGIN=http://localhost:3000
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Sin https://, por ejemplo chacota-awsugscz-dev.auth.us-east-1.amazoncognito.com
COGNITO_DOMAIN=

# DynamoDB Local (podman compose up -d)
CHACOTA_TABLE=chacota-local
DYNAMODB_ENDPOINT=http://localhost:8000

# Aprueba organizaciones nuevas automáticamente (útil en local o en instalaciones privadas)
CHACOTA_AUTO_APPROVE_ORGS=true

# Juego en vivo.
# Dirección que ven los jugadores en el QR (por defecto AMPLIFY_APP_ORIGIN):
CHACOTA_PUBLIC_ORIGIN=
# Modo local (pnpm dev:game levanta la API en :4000 y el broker de eventos en :4001):
GAME_API_URL=http://localhost:4000
EVENTS_LOCAL_URL=http://localhost:4001
EVENTS_HTTP_DNS=localhost:4001
EVENTS_REALTIME_URL=ws://localhost:4001/event/realtime
EVENTS_API_KEY=
# Modo nube: usa GameApiUrl, EventsHttpDns, EventsRealtimeDns y EventsApiKey de cdk-outputs,
# EVENTS_REALTIME_URL=wss://<EventsRealtimeDns>/event/realtime, deja EVENTS_LOCAL_URL vacío
# y apunta CHACOTA_TABLE a la tabla de la nube (sin DYNAMODB_ENDPOINT).
